{
  "title": "ShapeOps \u00b7 actual local runtime",
  "uid": "shapeops-local",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Retained successful requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "shapeops_inference_requests{outcome=\"success\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Retained failed requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "shapeops_inference_requests{outcome=\"failure\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latest request latency (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "shapeops_last_request_latency_ms",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}